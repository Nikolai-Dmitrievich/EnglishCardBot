# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the required values (especially BOT__TOKEN).
#
# NOTE ON DOCKER:
# When running via `docker compose up`, the variables DB__POSTGRES_HOST and
# DB__POSTGRES_PORT are automatically overridden by the docker-compose.yml
# environment section to 'db' and '5432'.
# The values below are defaults for local execution (python -m src.main).
# ==============================================================================

# === TELEGRAM BOT ===
# Obtain this token from @BotFather
BOT__TOKEN=your_bot_token_here

# Optional: Proxy URL for accessing the Telegram API (e.g., http://127.0.0.1:12334).
# Leave empty for a direct connection.
# WARNING: Using 127.0.0.1 only works when running the bot on the host machine.
# Inside a Docker container, 127.0.0.1 points to the container itself, not the host.
BOT__PROXY=


# === DATABASE CONNECTION ===
# For local execution: use 'localhost' and the port exposed by docker-compose (e.g., 5433).
# For Docker execution: these are overridden to 'db' and '5432' automatically.
DB__POSTGRES_USER=postgres
DB__POSTGRES_PASSWORD=postgres
DB__POSTGRES_HOST=localhost
DB__POSTGRES_PORT=5433
DB__POSTGRES_DB=english_card_bot


# === SQLALCHEMY ENGINE SETTINGS ===
# Connection pool and timeout configurations for asyncpg.
DB__ENGINE__POOL_PRE_PING=true
DB__ENGINE__POOL_RECYCLE=3600
DB__ENGINE__POOL_SIZE=5
DB__ENGINE__MAX_OVERFLOW=10
DB__ENGINE__ECHO=false
DB__ENGINE__STATEMENT_TIMEOUT_SECONDS=30
DB__ENGINE__COMMAND_TIMEOUT_SECONDS=35


# === SQLALCHEMY SESSION SETTINGS ===
# Determines whether objects are expired after a commit.
DB__SESSION__EXPIRE_ON_COMMIT=false
